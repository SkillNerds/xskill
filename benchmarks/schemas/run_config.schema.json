{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SkillNerds/xskill/benchmarks/schemas/run_config.schema.json",
  "title": "run_config",
  "description": "实验启动时落盘的运行配置。schema_version 固定为 1。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "phase",
    "algo",
    "benchmark",
    "split_manifest",
    "split_name",
    "model",
    "harness",
    "scorer",
    "code",
    "workers",
    "timeout_s",
    "failure_policy"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "phase": { "type": "string", "enum": ["train", "eval"] },
    "algo": { "type": "string", "enum": ["xskill", "skillopt", "noskill"] },
    "benchmark": { "type": "string", "enum": ["officeqa", "spreadsheet", "alfworld"] },
    "split_manifest": { "type": "string", "minLength": 1 },
    "split_name": {
      "type": "string",
      "enum": ["train", "val", "test", "train_plus_val"]
    },
    "model": { "type": "string", "minLength": 1 },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "tools"],
      "properties": {
        "id": {
          "type": "string",
          "enum": ["claude_code_native_skills", "skillopt_claude_code_exec"]
        },
        "tools": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "enum": ["Read", "Bash", "Skill"] }
        },
        "notes": { "type": "string" }
      }
    },
    "skill_sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "scorer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "module": { "type": "string" },
        "metric": { "type": "string" },
        "soft_metric": { "type": "string" },
        "commit": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "tolerance": { "type": "number" },
        "notes": { "type": "string" }
      }
    },
    "code": {
      "type": "object",
      "additionalProperties": false,
      "required": ["xskill_commit"],
      "properties": {
        "xskill_commit": { "type": "string", "minLength": 1 }
      }
    },
    "workers": { "type": "integer", "minimum": 1 },
    "timeout_s": { "type": "number", "minimum": 1 },
    "max_tool_turns": { "type": "integer", "minimum": 1 },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request_retries": { "type": "integer", "minimum": 0 },
        "case_retries": { "type": "integer", "minimum": 0 }
      }
    },
    "seed": { "type": "integer" },
    "failure_policy": { "type": "string", "minLength": 1 }
  }
}
